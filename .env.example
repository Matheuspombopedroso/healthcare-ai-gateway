# Copy to .env and change the values. docker compose reads .env automatically.
# Every key here is a placeholder for local development.

# Tenant API keys (only their SHA-256 hash is stored in Postgres).
TENANT_KEY_CLINIBUD=change-me-clinibud
TENANT_KEY_OMNIMAGISTRAL=change-me-omnimagistral
TENANT_KEY_PLUTUS=change-me-plutus
TENANT_KEY_LOADTEST=change-me-loadtest

# Secret for POST /admin/credits/topup (leave empty to disable the endpoint).
ADMIN_TOKEN=change-me-admin

# Mock backend latency profile.
MOCK_TTFT_MS=50
MOCK_INTER_TOKEN_MS=10

# Only needed when running the gateway outside Docker, against the local
# test containers described in docs/08-deployment.md:
# DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:15432/gateway?ssl=disable
# REDIS_URL=redis://localhost:16379/0
# MOCK_BASE_URL=http://localhost:8500/v1
# MODELS_CONFIG=config/models.yaml
# DB_POOL_SIZE=10
# REDIS_SOCKET_TIMEOUT=5

# vLLM (config/models.vllm.yaml)
# VLLM_PRIMARY_URL=http://localhost:8000/v1
# VLLM_PREMIUM_URL=http://localhost:8001/v1
# VLLM_BACKUP_URL=http://localhost:8002/v1
